# Environment Variables for Natuleadan Pleaides (Local & CI Contract)
# Local dev: copy to .env (git-ignored) and populate as needed.
# CI/CD: sync required vars via `gh variable set <KEY> --repo natuleadan/pleaides`.

# [var] Runtime environment (development | staging | production)
PLEAIDES_ENV=development
# [var] Logging verbosity (error | warn | info | debug)
PLEAIDES_LOG_LEVEL=info
